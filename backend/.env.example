PORT=4000
HOST=0.0.0.0
JWT_SECRET=change-me-to-a-long-random-secret
INSTANCE_ID=api-local
CORS_ORIGIN=http://localhost:5173

# Database: leave empty for local SQLite (./data/portal.sqlite), or set postgres://user:pass@host:5432/dbname
DATABASE_URL=

# Storage: "local" for single-node dev, "s3" for load-balanced multi-replica deployment (AWS S3 / R2 / MinIO)
STORAGE_DRIVER=local
LOCAL_UPLOAD_DIR=./uploads

# S3 / MinIO settings (used when STORAGE_DRIVER=s3)
S3_ENDPOINT=http://minio:9000
S3_REGION=us-east-1
S3_BUCKET=books
S3_ACCESS_KEY_ID=minioadmin
S3_SECRET_ACCESS_KEY=minioadmin
S3_FORCE_PATH_STYLE=true
